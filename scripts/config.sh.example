#!/usr/bin/env bash
# =========================================================
# config.sh
# 파이프라인 전역 설정. 모든 stage 스크립트가 이 파일을 source 함.
# =========================================================

set -euo pipefail

# ---- 프로젝트 루트 / 샘플 -------------------------------
PROJECT_DIR="/path/to/your_project"           # 트레일링 슬래시 제거 (경로 중복 방지)
RAW_DIR="${PROJECT_DIR}/00_raw"
SAMPLE_LIST="${PROJECT_DIR}/samples.txt"            # 샘플 ID 한 줄에 하나씩 (예: sowonkong_1)
SAMPLE_MAP="${PROJECT_DIR}/sample_map.tsv"          # sample_id <TAB> raw_file_prefix
                                                      # (raw 파일명이 sample_id와 다를 때 사용, 예: sowonkong_1 -> 01-1)

# ---- Reference ------------------------------------------
REF_DIR="/path/to/ref"                                    # reference 파일들 루트 (index, screen_refs 등도 이 아래 생성됨)
REF_GENOME_FA="${REF_DIR}/genome.fasta"
REF_GTF="${REF_DIR}/genome.gtf"
HISAT2_INDEX_PREFIX="${REF_DIR}/hisat2_index/genome"      # TODO: 실제 hisat2 index prefix 확인
BOWTIE2_TARGET_INDEX="${REF_DIR}/bowtie2_index/genome"    # FastQ Screen용 target genome bowtie2 index (HISAT2 index와 별개로 필요)
RSEQC_BED="${REF_DIR}/genome.bed"
FASTQ_SCREEN_CONF="${REF_DIR}/fastq_screen.conf"
SCREEN_REFS_DIR="${REF_DIR}/screen_refs"                   # rRNA/EColi/PhiX/Human index 저장 위치

# ---- 출력 디렉토리 (stage별) -----------------------------
OUT_ROOT="${PROJECT_DIR}/results"
DIR_QC_RAW="${OUT_ROOT}/01_fastqc_raw"
DIR_TRIM="${OUT_ROOT}/02_fastp"
DIR_SCREEN="${OUT_ROOT}/03_fastq_screen"
DIR_ALIGN="${OUT_ROOT}/04_hisat2"
DIR_RSEQC="${OUT_ROOT}/05_rseqc"
DIR_DUP="${OUT_ROOT}/06_dupradar"
DIR_MULTIQC="${OUT_ROOT}/multiqc"
LOG_DIR="${OUT_ROOT}/logs"
# 정량(StringTie) 이후는 ../modules/ 스크립트가 담당 (이 config.sh와 무관하게
# module04_stringtie.sh가 이 config.sh를 상대경로로 참조해 DIR_ALIGN 등만 재사용)

# Strand 자동판별 결과 저장 파일 (Stage 5에서 생성, Stage 6과 modules/module04가 자동으로 읽음)
STRAND_INFO_FILE="${OUT_ROOT}/strand_info.sh"

# ---- 리소스 -----------------------------------------------
THREADS=100              # fastqc/fastp/rseqc 등 단일 샘플 처리 도구용 (기존 설정 유지)
THREADS_PER_SAMPLE=24     # Stage 4 HISAT2: 샘플 1개당 쓸 스레드 수
PARALLEL_SAMPLES=8        # Stage 4 HISAT2: 동시에 병렬 처리할 샘플 개수
                           # THREADS_PER_SAMPLE x PARALLEL_SAMPLES <= nproc 되도록 조정
                           # 예: 24 x 8 = 192 (256코어 서버 기준 여유 있게 설정, 다른 사용자 작업 고려)
PARALLEL_SAMPLES_LIGHT=16  # Stage 5(RSeQC) 등 가벼운 도구용 동시 처리 샘플 개수 (스레드 옵션 없음)

# ---- conda 환경 이름 --------------------------------------
ENV_DUPRADAR="dupradar_env"
ENV_QC_TOOLS="qc_tools_env"
ENV_TRINITY="trinity_env"     # module09 (PtR + edgeR clustering) 전용, 기존 env 재사용
# fastqc/multiqc/fastp/hisat2/stringtie/samtools/R(edgeR) 는
# 시스템 PATH 또는 conda base 에 이미 존재 -> 별도 activate 불필요

# ---- conda 함수 --------------------------------------------
CONDA_SH="/path/to/miniconda3/etc/profile.d/conda.sh"
# 확인 방법: conda info --base   (결과 예: /root/miniconda3)
#           그 뒤에 /etc/profile.d/conda.sh 를 붙인 경로를 넣으면 됨
#           예: /root/miniconda3/etc/profile.d/conda.sh
# 주의: 이 값이 /path/to/... 로 남아있으면 모든 stage가 conda activate에서
#       실패합니다. setup.sh가 자동으로 채워주지만, 직접 확인도 권장합니다.

activate_env () {
    local env_name="$1"
    # conda activate 내부 스크립트(예: julia_activate.sh)가 정의 안 된 변수를
    # 참조하는 경우가 있어 set -u 와 충돌함 -> activate 하는 동안만 일시 해제
    set +u
    # shellcheck disable=SC1090
    source "${CONDA_SH}"
    conda activate "${env_name}"
    set -u
}

deactivate_env () {
    set +u
    conda deactivate
    set -u
}

# ---- Raw FASTQ 파일 찾기 함수 --------------------------------
# 1) SAMPLE_MAP(sample_map.tsv)이 있으면: sample_id -> raw_prefix 매핑을 먼저 조회
# 2) 그 raw_prefix로 bcl2fastq 명명 규칙(예: 01-1_S41_L002_R1_001.fastq.gz)과
#    단순 명명 규칙({prefix}_R1.fastq.gz)을 순서대로 시도
# 3) SAMPLE_MAP이 없으면 sample_id를 그대로 prefix로 사용
find_fastq () {
    local sample="$1"
    local read_num="$2"   # 1 또는 2

    local prefix="${sample}"
    if [[ -f "${SAMPLE_MAP}" ]]; then
        local mapped
        mapped=$(awk -F'\t' -v s="${sample}" '$1==s {print $2; exit}' "${SAMPLE_MAP}")
        if [[ -n "${mapped}" ]]; then
            prefix="${mapped}"
        fi
    fi

    local candidates=(
        "${RAW_DIR}/${prefix}_R${read_num}.fastq.gz"
        "${RAW_DIR}/${prefix}_S"*"_L"*"_R${read_num}_"*".fastq.gz"
        "${RAW_DIR}/${prefix}"*"_R${read_num}"*".fastq.gz"
    )

    for pattern in "${candidates[@]}"; do
        for f in ${pattern}; do
            if [[ -f "${f}" ]]; then
                echo "${f}"
                return 0
            fi
        done
    done

    return 1
}

# ---- 공통 디렉토리 생성 -------------------------------------
mkdir -p "${DIR_QC_RAW}" "${DIR_TRIM}" "${DIR_SCREEN}" "${DIR_ALIGN}" \
         "${DIR_RSEQC}" "${DIR_DUP}" "${DIR_MULTIQC}" "${LOG_DIR}"

# ---- 로깅 함수 ----------------------------------------------
log () {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}
